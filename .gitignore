# Raw run output inside review evidence: logs, compressed/streamed traces,
# JSON dumps, diffs and failed-run captures. Reviewed summaries (.md), screenshots
# and evidence tooling stay tracked.
/evidence/**/*.log
/evidence/**/*.gz
/evidence/**/*.jsonl
/evidence/**/*.stderr
/evidence/**/*.pprof
/evidence/**/*.json
/evidence/**/*.diff
/evidence/**/*.patch
/evidence/**/development-failures/

# Local zip-context skill scan output.
/zip_context_ignore.md

# Machine-specific agent rules (paths, disks, keys, servers); see AGENTS.md.
/AGENTS.local.md
/CLAUDE.local.md

